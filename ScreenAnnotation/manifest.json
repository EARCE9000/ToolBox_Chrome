{
  "manifest_version": 3,
  "name": "ScreenAnnotation - 矢印注釈",
  "version": "1.0.0",
  "description": "Webページ上に番号付き矢印を追加して注釈できる拡張機能",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "クリックで矢印を追加 / 右クリックでクリア"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/arrow.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
